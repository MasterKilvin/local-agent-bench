# Agent room image with extra libraries: the benchmark image plus the library versions some task code imports,
# so its own tests can run offline inside the sealed workroom.
# Build: podman build -t localhost/bench-agentroom-deps:1 -f Containerfile.deps .
FROM localhost/bench-agentroom:1
RUN pip install --no-cache-dir \
      httpx==0.28.1 fastapi==0.136.3 pillow==12.2.0 pydantic==2.13.4 starlette==1.6.0 \
      numpy==2.5.3 requests==2.34.2 soundfile==0.13.1 uvicorn==0.51.0 trimesh ddgs
