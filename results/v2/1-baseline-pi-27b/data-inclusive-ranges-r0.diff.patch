+class InvalidRange(ValueError):
+    """Raised when a range header is syntactically invalid or otherwise
+    unsatisfiable (status 416)."""
+
+
+# The header must match exactly one of `bytes=D-D`, `bytes=D-`, or `bytes=-D`,
+# where each D is one or more ASCII digits 0-9.  The [0-9] classes (as opposed
+# to int()) reject underscores, signs, whitespace and Unicode digits, and the
+# fullmatch anchors reject extra separators and multiple ranges.
+_RANGE = re.compile(r'bytes=([0-9]+-[0-9]+|[0-9]+-|-[0-9]+)')
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
+    """Return an inclusive (start, end) for one `bytes=` range over `length`
+    bytes, raising InvalidRange on bad syntax or an unsatisfiable range."""
+    if not isinstance(header, str) or _RANGE.fullmatch(header) is None:
+        raise InvalidRange('bad syntax')
+    if length == 0:
+        # Every range on empty data is unsatisfiable.
+        raise InvalidRange('empty data')
+
+    spec = header[len('bytes='):]
+
+    if spec.startswith('-'):
+        # Suffix form `bytes=-D`: the last D bytes.
+        suffix = int(spec[1:])
+        if suffix == 0:
+            raise InvalidRange('zero suffix')
+        return (max(length - suffix, 0), length - 1)
+
+    if spec.endswith('-'):
+        # Prefix form `bytes=D-`: from D to EOF.
+        start = int(spec[:-1])
+        if start >= length:
+            raise InvalidRange('start beyond EOF')
+        return (start, length - 1)
+
+    # Explicit form `bytes=D-D`: inclusive end.
     first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
-    return start, end
+    start = int(first)
+    end = int(last)
+    if start > end:
+        raise InvalidRange('reverse bounds')
+    if start >= length:
+        raise InvalidRange('start beyond EOF')
+    return (start, min(end, length - 1))
