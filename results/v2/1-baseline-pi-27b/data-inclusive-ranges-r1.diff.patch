+import re
+
+# Exactly one of: bytes=D-D, bytes=D-, or bytes=-D, with D being at least
+# one ASCII digit 0-9 (leading zeros allowed). No whitespace, signs,
+# underscores, Unicode digits, or multiple ranges.
+_RANGE = re.compile(
+    r'bytes='
+    r'(?:'
+    r'(?P<d1>[0-9]+)-(?P<d2>[0-9]+)'
+    r'|(?P<d3>[0-9]+)-'
+    r'|-(?P<n>[0-9]+)'
+    r')'
+)
+
+
+def parse_range(header):
+    """Parse a single-range header strictly per README.md grammar.
+
+    Returns ('range', start, end_or_None) or ('suffix', n, None),
+    or None if the header does not exactly match the required grammar.
+    """
+    if not isinstance(header, str):
+        return None
+    m = _RANGE.fullmatch(header)
+    if m is None:
+        return None
+    if m.group('d1') is not None:
+        return 'range', int(m.group('d1')), int(m.group('d2'))
+    if m.group('d3') is not None:
+        return 'range', int(m.group('d3')), None
+    return 'suffix', int(m.group('n')), None
