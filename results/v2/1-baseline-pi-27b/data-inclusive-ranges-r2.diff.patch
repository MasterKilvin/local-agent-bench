+"""Single-range parsing per README.md.
+
+Grammar: the header must exactly match one of `bytes=D-D`, `bytes=D-`, or
+`bytes=-D`, where each D is one or more ASCII digits 0-9 (leading zeros
+allowed). Anything else is a syntax error.
+"""
+
+_DIGITS = frozenset('0123456789')
+
+
+class RangeError(ValueError):
+    """Raised for invalid syntax and unsatisfiable ranges."""
+
+
+def _digits(s):
+    """Validate one or more ASCII decimal digits; return the int value."""
+    if not s or any(c not in _DIGITS for c in s):
+        raise RangeError('digits required: %r' % (s,))
+    # int() on a pre-validated ASCII string is safe (no underscores,
+    # no Unicode digits, no signs).
+    return int(s)
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
-    first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
+    """Return the inclusive (start, end) byte bounds for a range header."""
+    if not isinstance(header, str) or not header.startswith('bytes='):
+        raise RangeError('missing bytes= prefix: %r' % (header,))
+    parts = header[len('bytes='):].split('-')
+    if len(parts) != 2:
+        raise RangeError('bad range syntax: %r' % (header,))
+    first, last = parts
+    if first == '' and last == '':
+        raise RangeError('both endpoints omitted: %r' % (header,))
+    if length == 0:
+        raise RangeError('range on empty data: %r' % (header,))
+
+    if first == '':
+        # Suffix form: last N bytes.
+        n = _digits(last)
+        if n == 0:
+            raise RangeError('zero suffix: %r' % (header,))
+        return max(length - n, 0), length - 1
+
+    start = _digits(first)
+    if start >= length:
+        raise RangeError('start beyond EOF: %r' % (header,))
+    end = length - 1 if last == '' else min(_digits(last), length - 1)
+    if end < start:
+        raise RangeError('reverse bounds: %r' % (header,))
     return start, end
