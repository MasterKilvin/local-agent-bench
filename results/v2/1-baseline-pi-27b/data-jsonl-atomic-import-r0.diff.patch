 import json
 
+
 class ImportProblem(Exception):
     def __init__(self, line):
         self.line = line
         super().__init__(f'invalid line {line}')
 
+
+def _parse_record(raw):
+    text = raw.decode('utf-8')  # malformed UTF-8 -> UnicodeDecodeError
+    record = json.loads(text)   # malformed JSON -> ValueError (JSONDecodeError)
+    if not isinstance(record, dict):
+        raise ValueError('record must be an object')
+    record_id = record.get('id')
+    if not isinstance(record_id, str) or record_id == '':
+        raise ValueError('id must be a nonempty string')
+    if 'count' not in record:
+        raise ValueError('count is required')
+    count = record['count']
+    if isinstance(count, bool) or not isinstance(count, int):
+        raise ValueError('count must be an integer, not a bool or float')
+    return record
+
