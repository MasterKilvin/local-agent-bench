-        return self.entries[id]
+        """Return the product dict for id (or None), cached per version.
+
+        A stored entry is refreshed only when that id's catalog version has
+        changed (put or delete), so unrelated ids keep their cached reads.
+        The caller receives a copy, so mutating it never affects later reads.
+        """
+        version = self.catalog.versions.get(id, 0)
+        entry = self.entries.get(id)
+        if entry is None or entry[0] != version:
+            value = self.catalog.read(id)
+            self.entries[id] = (version, value)
+            entry = self.entries[id]
+        value = entry[1]
+        return None if value is None else value.copy()
