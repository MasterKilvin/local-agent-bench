+"""Single-range `bytes=` header grammar and bounds resolution."""
+
+import re
+
+__all__ = ['InvalidRange', 'bounds']
+
+_EXACT = re.compile(
+    r'bytes=([0-9]+)-([0-9]+)'  # bytes=D-D
+    r'|bytes=([0-9]+)-'         # bytes=D-
+    r'|bytes=-([0-9]+)'         # bytes=-D
+)
+
+
+class InvalidRange(ValueError):
+    """A range header violating the single-range grammar or semantics."""
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
-    first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
-    return start, end
+    """Resolve a range header against `length` bytes into inclusive (start, end).
+
+    Accepts exactly `bytes=D-D`, `bytes=D-`, or `bytes=-D`, each D one or
+    more ASCII digits (leading zeros allowed). An end past EOF clamps to
+    the last byte; a suffix covering the whole data selects the whole data.
+
+    Raises InvalidRange on malformed syntax (whitespace, signs,
+    underscores, non-ASCII digits, extra or repeated separators, both
+    endpoints omitted, multiple ranges), on unsatisfiable ranges (start at
+    or past EOF, zero suffix, reversed bounds), or on empty data.
+    """
+    if not isinstance(header, str):
+        raise InvalidRange('range header must be a str')
+    match = _EXACT.fullmatch(header)
+    if match is None:
+        raise InvalidRange('bad range syntax')
+    if length == 0:
+        raise InvalidRange('range not satisfiable over empty data')
+    if match.group(3) is not None:
+        start = int(match.group(3))
+        if start >= length:
+            raise InvalidRange('range start at or past EOF')
+        return start, length - 1
+    if match.group(4) is not None:
+        suffix = int(match.group(4))
+        if suffix == 0:
+            raise InvalidRange('zero-length suffix')
+        return max(0, length - suffix), length - 1
+    start = int(match.group(1))
+    end = int(match.group(2))
+    if start > end:
+        raise InvalidRange('range start after end')
+    if start >= length:
+        raise InvalidRange('range start at or past EOF')
+    return start, min(end, length - 1)
