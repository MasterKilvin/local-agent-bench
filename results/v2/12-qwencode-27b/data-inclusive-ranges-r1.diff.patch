+import re
+
+# Each alternative must match exactly one of:
+#     bytes=D-D     (start-end, end inclusive)
+#     bytes=D-      (start-EOF)
+#     bytes=-D      (last D bytes)
+# where D is one or more ASCII decimal digits. [0-9] rejects signs,
+# whitespace, Unicode digits, underscores, and Python-style spellings
+# (0x/0o/0b, 1_000), and fullmatch rejects extra separators / multiple ranges.
+_TWO = re.compile(r'bytes=([0-9]+)-([0-9]+)').fullmatch
+_FROM = re.compile(r'bytes=([0-9]+)-').fullmatch
+_SUFFIX = re.compile(r'bytes=-([0-9]+)').fullmatch
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
-    first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
-    return start, end
+    """Resolve one byte-range against `length` bytes of data.
+
+    Returns the served inclusive (start, end) pair, or None when the request
+    must yield 416 (start beyond EOF, reverse bounds, zero suffix, bad
+    syntax, or empty data).
+    """
+    if isinstance(header, (bytes, bytearray)):
+        header = bytes(header).decode('latin-1')
+    if length == 0:
+        return None
+
+    m = _TWO(header)
+    if m is not None:
+        start, end = int(m[1]), int(m[2])
+        if start > end or start >= length:
+            return None
+        return start, min(end, length - 1)
+
+    m = _FROM(header)
+    if m is not None:
+        start = int(m[1])
+        if start >= length:
+            return None
+        return start, length - 1
+
+    m = _SUFFIX(header)
+    if m is not None:
+        size = int(m[1])
+        if size == 0:
+            return None
+        return max(0, length - size), length - 1
+
+    return None
