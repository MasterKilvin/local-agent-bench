+    # Read the UTF-8 JSON Lines payload fully and validate every nonblank line before
+    # committing anything. Validating first is what guarantees an all-or-nothing import:
+    # if any line breaks the contract we raise before touching the store, leaving it
+    # exactly unchanged, and the reported line is the one-based physical line of the
+    # first offending line (blank lines still advance the counter).
+    records = []
+    for line, raw in enumerate(payload.split(b'\n'), 1):
         if not raw.strip():
             continue
         try:
-            record = json.loads(raw.decode('utf-8'))
-            if not isinstance(record, dict) or not isinstance(record.get('id'), str):
-                raise ValueError()
-        except (UnicodeDecodeError, ValueError):
+            text = raw.decode('utf-8')
+        except UnicodeDecodeError:
             raise ImportProblem(line)
+        try:
+            record = json.loads(text)
+        except ValueError:
+            raise ImportProblem(line)
+        if not _record_is_valid(record):
+            raise ImportProblem(line)
+        records.append(record)
+    # Commit only once the whole payload has validated; existing records are preserved
+    # and all imported records are appended in order.
