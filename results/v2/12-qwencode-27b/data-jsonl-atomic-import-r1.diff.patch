 import json
 
+
 class ImportProblem(Exception):
+    """Raised for a malformed or invalid line; carries the one-based physical line number."""
+
     def __init__(self, line):
         self.line = line
         super().__init__(f'invalid line {line}')
 
+
+def _record_is_valid(record):
+    # A valid record is a JSON object with a nonempty string id and an integer count.
+    if not isinstance(record, dict):
+        return False
+    if not isinstance(record.get('id'), str) or not record['id']:
+        return False
+    count = record.get('count')
+    # bool is a subclass of int, and floats (incl. integral 1.0) are not ints, so reject both.
+    return isinstance(count, int) and not isinstance(count, bool)
+
+
