@@ -0,0 +1,86 @@
+import unittest
+
+from sync import CheckpointStore, DurableSink, SyncJob
+
+BATCH = [(1, 'book'), (2, 'magazine'), (3, 'paper')]
+
+
+class RetrySafetyTest(unittest.TestCase):
+    def assert_safe_retry(self):
+        """Every input ID appears exactly once, in order, checkpoint complete."""
+        sink, checkpoint = self.sink, self.checkpoint
+        self.assertEqual(sink.rows, BATCH)
+        self.assertEqual(sink.staged, None)
+        self.assertEqual(checkpoint.value, BATCH[-1][0])
+        # contract: checkpoint must never skip a record absent from durable output
+        cp_ids = [r[0] for r in sink.rows]
+        self.assertLessEqual(checkpoint.value, cp_ids[-1] if cp_ids else 0)
+        self.assertNotIn(None, cp_ids)
+        self.assertEqual(len(cp_ids), len(set(cp_ids)))
+
+    def run_then_retry(self):
+        try:
+            SyncJob(self.sink, self.checkpoint).run(BATCH)
+            raise AssertionError('expected the injected failure to raise')
+        except RuntimeError:
+            pass
+        self.assertIsNotNone(self.fail_before)
+        # contract: after a failed run the checkpoint may not have advanced
+        # past a record that is absent from durable output
+        durable_ids = {r[0] for r in self.sink.rows}
+        for i in range(1, BATCH[-1][0] + 1):
+            if self.checkpoint.value >= i:
+                self.assertIn(i, durable_ids)
+        self.sink.restart()  # volatile staged output is discarded
+        SyncJob(self.sink, self.checkpoint).run(BATCH)
+        self.assert_safe_retry()
+
+    def test_failure_during_write(self):
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        self.sink.inject('write')
+        self.fail_before = True
+        self.run_then_retry()
+
+    def test_failure_before_flush_commit(self):
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        self.sink.inject('flush-before')
+        self.fail_before = True
+        self.run_then_retry()
+
+    def test_failure_after_flush_commit(self):
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        self.sink.inject('flush-after')
+        self.fail_before = True
+        self.run_then_retry()
+
+    def test_failure_before_checkpoint_save(self):
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        self.checkpoint.fail_next = True
+        self.fail_before = True
+        self.run_then_retry()
+
+    def test_failure_mid_batch(self):
+        # record 1 already committed by an earlier partial run
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        self.sink.write((1, 'book'))
+        self.sink.flush()
+        self.checkpoint.save(1)
+        self.sink.inject('write')  # strikes while writing record 2
+        self.fail_before = False
+        try:
+            SyncJob(self.sink, self.checkpoint).run(BATCH)
+            raise AssertionError('expected the injected failure to raise')
+        except RuntimeError:
+            pass
+        self.sink.restart()
+        SyncJob(self.sink, self.checkpoint).run(BATCH)
+        self.assert_safe_retry()
+
+    def test_clean_run(self):
+        self.sink, self.checkpoint = DurableSink(), CheckpointStore()
+        SyncJob(self.sink, self.checkpoint).run(BATCH)
+        self.assert_safe_retry()
+
+
+if __name__ == '__main__':
+    unittest.main()
