+import re
+
+# Each D is one or more ASCII digits (leading zeros allowed). The grammar
+# exactly forbids whitespace, signs, underscores, unicode digits, multiple
+# ranges, and a header with both endpoints omitted (`bytes=-` matches none
+# of these patterns).
+_START_ONLY = re.compile(r'bytes=([0-9]+)-')
+_SUFFIX = re.compile(r'bytes=-([0-9]+)')
+_RANGE = re.compile(r'bytes=([0-9]+)-([0-9]+)')
+
+
+def parse(header, length):
+    """Validate a single-range header against a `length`-byte payload.
+
+    Returns (start, end, ok) with an inclusive end. ok is False for bad
+    syntax, bounds beyond EOF, zero suffix, or empty data (all 416 cases).
+    """
+    if not isinstance(header, str):
+        return 0, 0, False
+    m = _RANGE.fullmatch(header)
+    if m:
+        start, end = int(m.group(1)), int(m.group(2))
+    else:
+        m = _START_ONLY.fullmatch(header)
+        if m:
+            start, end = int(m.group(1)), length - 1
+        else:
+            m = _SUFFIX.fullmatch(header)
+            if m:
+                suffix = int(m.group(1))
+                if suffix == 0 or length == 0:
+                    return 0, 0, False
+                start, end = max(0, length - suffix), length - 1
+            else:
+                return 0, 0, False
+    if length == 0 or start >= length:
+        return start, end, False
+    if end > length - 1:
+        end = length - 1
+    if end < start:
+        return start, end, False
+    return start, end, True
