+import re
+
+# The grammar is exact: one or more ASCII digits (0-9) only. Leading zeros
+# are allowed; whitespace, signs, underscores, hex/octal spellings, Unicode
+# digits and multiple ranges are all rejected. Using [0-9] (not \d) keeps
+# the match ASCII-only, and fullmatch forbids any leading/trailing garbage.
+_FULL = re.compile(r'bytes=([0-9]+)-([0-9]+)')
+_PREFIX = re.compile(r'bytes=([0-9]+)-')
+_SUFFIX = re.compile(r'bytes=-([0-9]+)')
+
+
+class RangeError(ValueError):
+    """Raised when a Range header is malformed or unsatisfiable."""
+
+
+def parse(header):
+    """Parse an exact single-range header.
+
+    Returns one of:
+        ('full', start, end)        # bytes=start-end
+        ('prefix', start)           # bytes=start-
+        ('suffix', count)           # bytes=-count
+    with all values as ints. Raises RangeError for any other spelling.
+    """
+    if not isinstance(header, str):
+        raise RangeError('range header must be a string')
+    m = _FULL.fullmatch(header)
+    if m is not None:
+        return 'full', int(m.group(1)), int(m.group(2))
+    m = _PREFIX.fullmatch(header)
+    if m is not None:
+        return 'prefix', int(m.group(1))
+    m = _SUFFIX.fullmatch(header)
+    if m is not None:
+        return 'suffix', int(m.group(1))
+    raise RangeError('bad range syntax: %r' % (header,))
