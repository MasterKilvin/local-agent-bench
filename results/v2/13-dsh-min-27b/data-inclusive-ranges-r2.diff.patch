+    """Return an inclusive (start, end) byte pair, or None for 416.
+
+    The header must exactly match one of `bytes=D-D`, `bytes=D-`, or
+    `bytes=-D`, with each D one or more ASCII digits 0-9. Anything else,
+    plus unsatisfiable ranges (start beyond EOF, zero suffix, reverse
+    bounds, or empty data), yields None.
+    """
+    if length == 0 or not isinstance(header, str):
+        return None
+    m = _BOTH.fullmatch(header)
+    if m is not None:
+        start, end = int(m.group(1)), int(m.group(2))
+        if start > end or start >= length:
+            return None
+        return start, min(end, length - 1)
+    m = _START.fullmatch(header)
+    if m is not None:
+        start = int(m.group(1))
+        if start >= length:
+            return None
+        return start, length - 1
+    m = _SUFFIX.fullmatch(header)
+    if m is not None:
+        n = int(m.group(1))
+        if n == 0:
+            return None
+        return max(0, length - n), length - 1
+    return None
