 import json
 
+
 class ImportProblem(Exception):
     def __init__(self, line):
         self.line = line
         super().__init__(f'invalid line {line}')
 
+
+def _valid_id(record):
+    ident = record.get('id')
+    return isinstance(ident, str) and ident != ''
+
+
+def _valid_count(record):
+    if 'count' not in record:
+        return False
+    value = record['count']
+    # JSON integer only: bool (a subclass of int) and floats are invalid.
+    return not isinstance(value, bool) and isinstance(value, int)
+
+
+def _parse_line(raw, line):
+    try:
+        text = raw.decode('utf-8')
+    except UnicodeDecodeError:
+        raise ImportProblem(line)
+    try:
+        record = json.loads(text)
+    except ValueError:
+        # Covers json.JSONDecodeError and structural problems.
+        raise ImportProblem(line)
+    if (
+        not isinstance(record, dict)
+        or not _valid_id(record)
+        or not _valid_count(record)
+    ):
+        raise ImportProblem(line)
+    return record
+
+
