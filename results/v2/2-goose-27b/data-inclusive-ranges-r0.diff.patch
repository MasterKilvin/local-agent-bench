+_ALLOWED = frozenset(b'0123456789')
+
+
+class RangeSyntaxError(ValueError):
+    pass
+
+
+def parse_digits(token):
+    """Parse a digits-only token using exactly ASCII 0-9.
+
+    Raises RangeSyntaxError for empty input, signs, underscores, or any
+    non-ASCII byte (including Unicode digits) anywhere in the token.
+    Leading zeros are allowed.
+    """
+    if not token:
+        raise RangeSyntaxError('empty digit token')
+    if any(byte not in _ALLOWED for byte in token):
+        raise RangeSyntaxError('non-ASCII decimal digits')
+    return int(token, 10)
+
+
+def bounds(header):
+    """Parse one `bytes=...` range header.
+
+    Returns (head, tail) where head is the start or None for a suffix,
+    and tail is the end or None for a full range.
+
+    Raises RangeSyntaxError unless the header exactly matches one of
+    `bytes=D-D`, `bytes=D-`, or `bytes=-D`, where each D is one or more
+    ASCII digits 0-9.
+    """
+    if not isinstance(header, str):
+        raise RangeSyntaxError('header must be a string')
+    try:
+        raw = header.encode('ascii')
+    except UnicodeEncodeError:
+        raise RangeSyntaxError('non-ASCII header')
+    if not raw.startswith(b'bytes='):
+        raise RangeSyntaxError('bad prefix')
+    spec = raw[len(b'bytes='):]
+    parts = spec.split(b'-')
+    if len(parts) != 2:
+        raise RangeSyntaxError('bad syntax')
+    head = parse_digits(parts[0]) if parts[0] else None
+    tail = parse_digits(parts[1]) if parts[1] else None
+    if head is None and tail is None:
+        raise RangeSyntaxError('both endpoints omitted')
+    return head, tail
