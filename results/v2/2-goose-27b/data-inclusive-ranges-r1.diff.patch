+def parse_header(header):
+    """Return a parse result for a single-range header, or None.
+
+    Accepted grammar (exactly one of):
+        bytes=D-D
+        bytes=D-
+        bytes=-D
+    where D is one or more ASCII decimal digits 0-9 (leading zeros allowed).
+
+    Returns:
+        ('suffix', n)            for bytes=-D
+        ('absolute', start, end) for bytes=D-D, where end is None for bytes=D-
+        None                     for anything else (bad syntax)
+    """
+    if not isinstance(header, str):
+        return None
+    if not header.startswith('bytes='):
+        return None
+    spec = header[len('bytes='):]
+    if spec.count('-') != 1:
+        return None
     first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
-    return start, end
+
+    def digits(s):
+        if not s or not s.isascii():
+            return None
+        if any(c not in '0123456789' for c in s):
+            return None
+        return int(s)
+
+    if first == '' and last == '':
+        return None
+    if first == '':
+        n = digits(last)
+        if n is None:
+            return None
+        return ('suffix', n)
+    start = digits(first)
+    if start is None:
+        return None
+    if last == '':
+        return ('absolute', start, None)
+    end = digits(last)
+    if end is None:
+        return None
+    return ('absolute', start, end)
