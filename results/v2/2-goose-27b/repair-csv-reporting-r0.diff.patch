+    """Return the data rows of *text* as a list of lists of fields.
+
+    Fields follow standard CSV rules (RFC 4180): a comma or newline inside a
+    double-quoted field stays part of the field, and a doubled double quote
+    ("") is an escaped quote. The first record is the header row and is
+    excluded from the result.
+    """
+    reader = csv.reader(io.StringIO(text))
+    records = list(reader)
+    if not records:
+        return []
+    # Drop the header record (e.g. sku,name,qty).
+    return records[1:]
