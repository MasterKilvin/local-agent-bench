+import unittest
+
+from shop.checkout import checkout
+
+
+class CheckoutRegressionTests(unittest.TestCase):
+    def test_single_line_quantity_above_one_applies_promotion_once(self):
+        # Subtotal 20.00, rate 0.10 -> payable 18.00.
+        # Double-discounting yields 16.20, which must fail.
+        lines = [{'price': '10.00', 'qty': 2}]
+        self.assertEqual(checkout(lines, '0.10'), '18.00')
+
+    def test_multiple_lines_all_quantities_one_applies_promotion_once(self):
+        # Subtotal 7.77, rate 0.05 -> 7.3815, ROUND_HALF_UP -> 7.38.
+        # Double-discounting yields 7.01, which must fail.
+        lines = [
+            {'price': '3.33', 'qty': 1},
+            {'price': '4.44', 'qty': 1},
+        ]
+        self.assertEqual(checkout(lines, '0.05'), '7.38')
+
+
+if __name__ == '__main__':
+    unittest.main()
