+import unittest
+
+from shop.checkout import checkout
+
+
+class CheckoutRegressionTest(unittest.TestCase):
+    def test_single_line_quantity_above_one(self):
+        # Subtotal 20.00, one 10% promotion: 20.00 * 0.90 = 18.00.
+        # (Double application of the promotion gives 16.20.)
+        self.assertEqual(checkout([{'price': '10.00', 'qty': 2}], '0.10'), '18.00')
+
+    def test_multiple_lines_all_quantity_one(self):
+        # Subtotal 12.55, one 20% promotion: 12.55 * 0.80 = 10.04.
+        # (Double application of the promotion gives 8.03.)
+        lines = [{'price': '5.25', 'qty': 1}, {'price': '7.30', 'qty': 1}]
+        self.assertEqual(checkout(lines, '0.20'), '10.04')
+
+
+if __name__ == '__main__':
+    unittest.main()
