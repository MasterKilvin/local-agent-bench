+_ASCII_DIGITS = frozenset('0123456789')
+_PREFIX = 'bytes='
+
+
+def _is_decimal(text):
+    return bool(text) and all(c in _ASCII_DIGITS for c in text)
+
+
+def parse(header):
+    if not isinstance(header, str) or not header.startswith(_PREFIX):
+        return None
+    parts = header[len(_PREFIX):].split('-')
+    if len(parts) != 2:
+        return None
+    first, last = parts
+    if not first and not last:
+        return None
+    if first and not _is_decimal(first):
+        return None
+    if last and not _is_decimal(last):
+        return None
+    start = int(first) if first else None
+    end = int(last) if last else None
+    return start, end
+
