-    return start, end
+    if not isinstance(header, str):
+        raise InvalidRange('range header must be a string')
+    m = _FULL.fullmatch(header)
+    if m is not None:
+        start, end = int(m.group(1)), int(m.group(2))
+        if start > end:
+            raise InvalidRange('reversed bounds')
+        if start >= length:
+            raise InvalidRange('start beyond EOF')
+        return start, min(end, length - 1)
+    m = _OPEN.fullmatch(header)
+    if m is not None:
+        start = int(m.group(1))
+        if start >= length:
+            raise InvalidRange('start beyond EOF')
+        return start, length - 1
+    m = _SUFFIX.fullmatch(header)
+    if m is not None:
+        n = int(m.group(1))
+        if n == 0:
+            raise InvalidRange('zero suffix')
+        if length == 0:
+            raise InvalidRange('empty data')
+        return max(length - n, 0), length - 1
+    raise InvalidRange(f'bad range header: {header!r}')
