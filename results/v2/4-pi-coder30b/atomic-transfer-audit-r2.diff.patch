+from bank import Ledger, TransferService
+
+
+def test_with_injection():
+    ledger = Ledger({'cash': 700, 'savings': 300})
+    
+    # Test that injection works correctly and doesn't cause inconsistent state
+    def inject(phase):
+        if phase == 'after_debit':
+            print(f"Debit completed for {phase}")
+        elif phase == 'after_credit':
+            print(f"Credit completed for {phase}")
+        elif phase == 'before_audit':
+            print(f"Audit about to be committed for {phase}")
+            # This would cause a failure in the original implementation
+            raise Exception("Injection error")
+    
+    try:
+        TransferService(ledger).transfer('cash', 'savings', 125, inject)
+    except Exception as e:
+        print(f"Transfer failed as expected: {e}")
+    
+    # Check that balances haven't changed (should be unchanged)
+    print(f"Balances after failed transfer: {ledger.balances}")
+    print(f"Audit log after failed transfer: {ledger.audit}")
+
+
+if __name__ == '__main__':
+    test_with_injection()
