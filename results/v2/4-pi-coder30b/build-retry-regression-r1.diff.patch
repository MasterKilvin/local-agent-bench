+import unittest
+from retry.wrapper import run, TransientError, PermanentError
+
+class TestRetryWrapper(unittest.TestCase):
+    
+    def test_transient_error_retries(self):
+        """Transient errors should be retried up to the attempt limit"""
+        call_count = 0
+        
+        def failing_operation():
+            nonlocal call_count
+            call_count += 1
+            raise TransientError("Transient failure")
+            
+        with self.assertRaises(TransientError):
+            run(failing_operation, attempts=3)
+        
+        # With 3 attempts, should try 3 times (once per attempt)
+        # This is the expected correct behavior 
+        self.assertEqual(call_count, 3)
+    
+    def test_permanent_error_stops_immediately(self):
+        """Permanent errors should propagate immediately without retries"""
+        call_count = 0
+        
+        def failing_operation():
+            nonlocal call_count
+            call_count += 1
+            raise PermanentError("Permanent failure")
+            
+        with self.assertRaises(PermanentError):
+            run(failing_operation, attempts=3)
+        
+        # Should only be called once (no retries)
+        # This represents what the correct behavior SHOULD be
+        self.assertEqual(call_count, 1)
+
+if __name__ == '__main__':
+    unittest.main()
