+def parse_range_header_safe(header, length):
+    """Safe range header parser with proper validation"""
+    # Validate syntax exactly matches allowed format
+    if not header:
+        return None, None
+        
+    if not header.startswith('bytes='):
+        return None, None
+        
+    spec = header[6:]  # remove "bytes=" prefix
+    
+    # Reject any whitespace in the spec (including trailing newlines)
+    if spec != spec.strip():
+        return None, None
+    
+    # Validate format: must be one of:
+    # bytes=D-D, bytes=D-, bytes=-D
+    # where each D is one or more ASCII digits 0-9
+    
+    # Handle special cases
+    if spec.startswith('-'):
+        # Should be: bytes=-N (suffix range)
+        suffix_part = spec[1:]
+        if not suffix_part.isdigit():
+            return None, None
+        n = int(suffix_part)
+        # Suffix of 0 is invalid in this context - it would return empty range
+        if n == 0:
+            return None, None
+        start = max(0, length - n)
+        end = length - 1  # Adjust for inclusive range (up to but not including the end)
+        return start, end
+    
+    # For normal range (bytes=N-D or bytes=N-)
+    if '-' in spec:
+        parts = spec.split('-', 1)
+        
+        # Check for valid format: first part must be valid number (or empty), second part must be valid number (or empty)  
+        first, second = parts
+        
+        # Handle cases where both are empty 
+        if first == '' and second == '':
+            return None, None 
+            
+        # Validate numbers with no leading zeros (except for '0')
+        if first != '' and not first.isdigit():
+            return None, None
+        if second != '' and not second.isdigit():
+            return None, None
+            
+        # Additional validation to prevent leading zeros
+        if first != '0' and first.startswith('0') and len(first) > 1:
+            return None, None
+        if second != '0' and second.startswith('0') and len(second) > 1:
+            return None, None
+        
+        try:
+            start = int(first) if first != '' else 0
+            end = int(second) if second != '' else length - 1
+            
+            # Check validity of the range
+            if start >= length:
+                return None, None  # Start beyond EOF
+            if second != '' and end < start:
+                return None, None  # Reverse bounds
+                
+            # Clamp end to EOF (inclusive)
+            end = min(end, length - 1)
+            return start, end
+        except ValueError:
+            return None, None
+            
+    # Simple number format (bytes=N)
+    else:
+        if not spec.isdigit():
+            return None, None
+        if spec.startswith('0') and len(spec) > 1:
+            return None, None  # No leading zeros except for '0'
+            
+        start = int(spec)
+        if start >= length:
+            return None, None  # Start beyond EOF
+            
+        return start, length - 1  # Adjust for inclusive range
+
+
