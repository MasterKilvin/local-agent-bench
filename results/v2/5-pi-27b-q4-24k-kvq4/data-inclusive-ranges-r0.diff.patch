+import re
+
+_RANGE = re.compile(r'bytes=([0-9]+)-([0-9]+)')
+_PREFIX = re.compile(r'bytes=([0-9]+)-')
+_SUFFIX = re.compile(r'bytes=-([0-9]+)')
+
+
+def parse_range(header):
+    """Parse a single range header.
+
+    Returns one of ('range', start, end_or_None), ('suffix', n), or None.
+    The header must exactly match bytes=D-D, bytes=D-, or bytes=-D where D
+    is one or more ASCII digits 0-9 (leading zeros allowed).  Anything else
+    (whitespace, signs, underscores, Unicode digits, extra separators,
+    multiple ranges, both endpoints omitted) is invalid.
+    """
+    if not isinstance(header, str):
+        return None
+    m = _RANGE.fullmatch(header)
+    if m is not None:
+        return 'range', int(m.group(1)), int(m.group(2))
+    m = _PREFIX.fullmatch(header)
+    if m is not None:
+        return 'range', int(m.group(1)), None
+    m = _SUFFIX.fullmatch(header)
+    if m is not None:
+        return 'suffix', int(m.group(1)), None
+    return None
+
+
+def resolve(spec, length):
+    """Resolve a parsed single range against an entity of `length` bytes.
+
+    Returns an inclusive (start, end) pair, or None if the range is
+    unsatisfiable (start at/past EOF, zero suffix, or reverse bounds).
+    An end past EOF is clamped; a suffix longer than the entity yields
+    the whole entity.
+    """
+    if spec is None or length == 0:
+        return None
+    kind, a, b = spec
+    if kind == 'suffix':
+        if a == 0:
+            return None
+        return max(0, length - a), length - 1
+    start = a
+    end = length - 1 if b is None else min(b, length - 1)
+    if start > end:
+        return None
     return start, end
