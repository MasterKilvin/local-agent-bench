 def serve(data, range_header=None):
+    """Serve ``data`` (bytes) with an optional single byte range.
+
+    Returns ``(status, headers, body)``. Headers include
+    ``Content-Length``; a selected range also carries ``Content-Range``.
+    """
     if range_header is None:
         return 200, {'Content-Length': str(len(data))}, data
-    start, end = bounds(range_header, len(data))
-    body = data[start:end]
+
+    length = len(data)
+    try:
+        start, end = parse(range_header)
+    except MalformedRange:
+        return _not_satisfiable(length)
+
+    # Every range on empty data returns 416.
+    if length == 0:
+        return _not_satisfiable(length)
+
+    if start is None and end is not None:
+        # bytes=-N: the last N bytes; bytes=-0 is a zero-length suffix.
+        if end == 0:
+            return _not_satisfiable(length)
+        first = length - end if end < length else 0
+        return _satisfiable(length, first, length - 1, data[first:length])
+
+    if start is not None and end is None:
+        # bytes=D-: from D to EOF.
+        if start >= length:
+            return _not_satisfiable(length)
+        return _satisfiable(length, start, length - 1, data[start:length])
+
+    # bytes=D-D: inclusive end.
+    if start >= length:
+        return _not_satisfiable(length)
+    if end < start:
+        return _not_satisfiable(length)
+    last = end if end < length else length - 1
+    return _satisfiable(length, start, last, data[start:last + 1])
+
+
+def _not_satisfiable(length):
+    return 416, {'Content-Length': '0',
+                 'Content-Range': f'bytes */{length}'}, b''
+
+
+def _satisfiable(length, start, end, body):
     return 206, {'Content-Length': str(len(body)),
-                 'Content-Range': f'bytes {start}-{end}/{len(data)}'}, body
+                 'Content-Range': f'bytes {start}-{end}/{length}'}, body
