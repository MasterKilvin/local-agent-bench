+def _render_csv(rows):
     out = io.StringIO(newline='')
     writer = csv.writer(out, lineterminator='\n')
     writer.writerow(FIELDS)
     for row in rows:
         writer.writerow([row[field] for field in FIELDS])
     return out.getvalue()
