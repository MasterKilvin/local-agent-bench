+import unittest
+
+from shop.checkout import checkout
+
+
+class DoubleDiscountRegressionTest(unittest.TestCase):
+    """Promotion must be applied exactly once to the subtotal."""
+
+    def test_single_line_quantity_above_one(self):
+        # 3 x 10.00 = 30.00 subtotal; 10% off once -> 27.00
+        # (double discount would yield 24.30)
+        lines = [{'price': '10.00', 'qty': 3}]
+        self.assertEqual(checkout(lines, '0.10'), '27.00')
+
+    def test_multiple_lines_all_quantity_one(self):
+        # 10.00 + 15.00 = 25.00 subtotal; 20% off once -> 20.00
+        # (double discount would yield 16.00)
+        lines = [{'price': '10.00', 'qty': 1}, {'price': '15.00', 'qty': 1}]
+        self.assertEqual(checkout(lines, '0.20'), '20.00')
+
+
+if __name__ == '__main__':
+    unittest.main()
