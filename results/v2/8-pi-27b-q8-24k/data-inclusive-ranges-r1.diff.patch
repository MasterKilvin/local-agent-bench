+import re
+
+# The header must exactly match one of these three forms. D is one or more
+# ASCII digits 0-9 (leading zeros allowed). Anything else -- whitespace,
+# signs, underscores, unicode digits, extra separators, multiple ranges,
+# both endpoints omitted -- is rejected.
+_RANGE_SPECS = (
+    (re.compile(r'\Abytes=([0-9]+)-([0-9]+)\Z'), 'both'),  # start-end (end inclusive)
+    (re.compile(r'\Abytes=([0-9]+)-\Z'), 'start'),         # start-EOF
+    (re.compile(r'\Abytes=-([0-9]+)\Z'), 'suffix'),         # last N bytes
+)
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
-    first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
-    return start, end
+    """Return (start, end) with an inclusive end, or None if the range is
+    unsatisfiable or the header is malformed."""
+    if length == 0:
+        return None
+    for pattern, kind in _RANGE_SPECS:
+        match = pattern.fullmatch(header)
+        if match is None:
+            continue
+        if kind == 'both':
+            start = int(match.group(1), 10)
+            end = int(match.group(2), 10)
+            if start >= length or start > end:
+                return None
+            end = min(end, length - 1)
+        elif kind == 'start':
+            start = int(match.group(1), 10)
+            if start >= length:
+                return None
+            end = length - 1
+        else:  # suffix
+            suffix = int(match.group(1), 10)
+            if suffix == 0:
+                return None
+            start = max(0, length - suffix)
+            end = length - 1
+        return start, end
+    return None
