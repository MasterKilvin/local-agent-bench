+    """Return inclusive (start, end) for a valid single range, else None."""
+    if not isinstance(header, str):
+        return None
+    m = _SPEC.match(header)
+    if m is None:
+        return None
+    first, last = m.group(1), m.group(2)
+    if not first and not last:
+        return None
+    if last:
+        if not first:
+            # Suffix: last N bytes.
+            n = int(last)
+            if n == 0:
+                return None
+            end = length - 1
+            start = max(0, length - n)
+        else:
+            start = int(first)
+            end = int(last)
+            if end >= length:
