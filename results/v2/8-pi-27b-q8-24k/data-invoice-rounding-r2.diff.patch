+def _quantize(value):
+    result = value.quantize(CENTS, rounding=ROUND_HALF_UP)
+    if result == 0:
+        result = abs(result)  # avoid "-0.00"
+    return result
+
+
+def _fmt(value):
+    return f'{_quantize(value):.2f}'
