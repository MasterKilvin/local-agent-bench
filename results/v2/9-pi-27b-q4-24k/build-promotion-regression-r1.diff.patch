+import unittest
+
+from shop.checkout import checkout
+
+
+class TestSingleLineQuantityAboveOne(unittest.TestCase):
+    def test_promotion_applied_once_single_line_qty_two(self):
+        # Subtotal 20.00; one 10% promotion -> 20.00 * 0.90 = 18.00.
+        # Double-applied discount would yield 20.00 * 0.81 = 16.20.
+        self.assertEqual(checkout([{'price': '10.00', 'qty': 2}], '0.10'), '18.00')
+
+
+class TestMultipleLinesAllQuantityOne(unittest.TestCase):
+    def test_promotion_applied_once_multiple_lines(self):
+        # Subtotal 3.33 + 5.05 = 8.38; one 20% promotion -> 8.38 * 0.80
+        # = 6.704, rounded HALF_UP -> 6.70.
+        # Double-applied discount would yield 8.38 * 0.64 = 5.3632 -> 5.36.
+        lines = [{'price': '3.33', 'qty': 1}, {'price': '5.05', 'qty': 1}]
+        self.assertEqual(checkout(lines, '0.20'), '6.70')
+
+
+if __name__ == '__main__':
+    unittest.main()
