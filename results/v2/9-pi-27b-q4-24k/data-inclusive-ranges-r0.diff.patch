+import re
+
+# Grammar: one of `bytes=D-D`, `bytes=D-`, or `bytes=-D`, where each D is
+# one or more ASCII digits 0-9. `fullmatch` with a `[0-9]` class enforces
+# the exact form: no whitespace, signs, underscores, or Unicode digits.
+_BOTH = re.compile(r'bytes=([0-9]+)-([0-9]+)')
+_START = re.compile(r'bytes=([0-9]+)-')
+_SUFFIX = re.compile(r'bytes=-([0-9]+)')
+
+
+def parse(header):
+    """Return (start, end) with None for an omitted endpoint; raise
+    ValueError on bad syntax."""
+    if not isinstance(header, str):
+        raise ValueError('range header must be a string')
+    m = _BOTH.fullmatch(header)
+    if m:
+        return int(m[1]), int(m[2])
+    m = _START.fullmatch(header)
+    if m:
+        return int(m[1]), None
+    m = _SUFFIX.fullmatch(header)
+    if m:
+        return None, int(m[1])
+    raise ValueError('bad range syntax')
+
+
 def bounds(header, length):
-    spec = header.removeprefix('bytes=')
-    first, last = spec.split('-', 1)
-    start = int(first or 0)
-    end = int(last or length)
+    """Resolve a single-range header against data of `length` bytes.
+
+    Returns the inclusive (start, end). Raises ValueError for headers that
+    cannot be satisfied: start beyond EOF, zero-length suffix, reversed
+    bounds, or bad syntax. An end past EOF is clamped.
+    """
+    start, end = parse(header)
+    if start is None:
+        # `bytes=-N`: last N bytes; N must be positive and data nonempty.
+        if end == 0 or length == 0:
+            raise ValueError('unsatisfiable range')
+        return max(0, length - end), length - 1
+    if start >= length:
+        raise ValueError('unsatisfiable range')
+    if end is None:
+        end = length - 1
+    else:
+        if start > end:
+            raise ValueError('unsatisfiable range')
+        end = min(end, length - 1)
