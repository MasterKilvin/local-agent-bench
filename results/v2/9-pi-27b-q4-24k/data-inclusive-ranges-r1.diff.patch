+"""Strict single-range parsing.
+
+The header must exactly match one of:
+
+    bytes=D-D
+    bytes=D-
+    bytes=-D
+
+where each D is one or more plain ASCII digits 0 through 9 (leading zeros
+allowed).  Anything else -- whitespace, signs, underscores, Unicode digits,
+multiple ranges, empty endpoints -- is rejected with ValueError.
+"""
+import re
+
+_FULL = re.compile(r'bytes=([0-9]+)-([0-9]+)')
+_PREFIX = re.compile(r'bytes=([0-9]+)-')
+_SUFFIX = re.compile(r'bytes=-([0-9]+)')
+
+
+def parse(header):
+    """Parse *header* and return (kind, a, b).
+
+    kind is 'full' (a=start, b=end), 'prefix' (a=start) or 'suffix'
+    (a=number of trailing bytes).  Raises ValueError when the header does
+    not match the grammar exactly.
+    """
+    if isinstance(header, (bytes, bytearray, memoryview)):
+        try:
+            header = bytes(header).decode('ascii')
+        except UnicodeDecodeError:
+            raise ValueError('header is not ASCII')
+    if not isinstance(header, str):
+        raise ValueError('header must be a string')
+
+    m = _FULL.fullmatch(header)
+    if m:
+        return 'full', int(m.group(1), 10), int(m.group(2), 10)
+    m = _PREFIX.fullmatch(header)
+    if m:
+        return 'prefix', int(m.group(1), 10), 0
+    m = _SUFFIX.fullmatch(header)
+    if m:
+        return 'suffix', int(m.group(1), 10), 0
+    raise ValueError('bad range syntax')
