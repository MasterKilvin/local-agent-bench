+    @classmethod
+    def _strip_trailing_whitespace(cls, expression: str) -> str:
+        length = len(expression)
+        run_start = length
+        while run_start > 0 and expression[run_start - 1] in cls._WHITESPACE:
+            run_start -= 1
+        if run_start == length:
+            return expression
+        backslashes = 0
+        k = run_start - 1
+        while k >= 0 and expression[k] == '\\':
+            backslashes += 1
+            k -= 1
+        if backslashes % 2 == 1:
+            run_start += 1
+        return expression[:run_start]
+
+    _WHITESPACE = set(' \t\n\r\f\v')
