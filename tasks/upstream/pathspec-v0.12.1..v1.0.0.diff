+	print(f"Read: {PYPROJECT_IN_TOML}")
+	output = PYPROJECT_IN_TOML.read_text()
+
+	print(f"Read: {VERSION_PY}")
+	version_input = VERSION_PY.read_text()
+	version = re.search(
+		'^__version__\\s*=\\s*"([^"]+)"', version_input, re.M,
+	).group(1)
+
+	# Replace version.
+	output = output.replace("__VERSION__", version)
